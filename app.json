{
  "expo": {
    "name": "Gem Dictionary",
    "slug": "gem-dictionary",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3287"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gemsphere.gemdictionary"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F3287",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gemsphere.gemdictionary",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-asset"
    ]
  }
}
